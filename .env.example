# ============================================================================
# PetShip environment configuration
# Copy this file to `.env` and fill in values as needed.
# The app runs end-to-end in development with NO external keys set:
# all paid/keyed integrations degrade gracefully (console email, local file
# storage, templated AI responses, disabled Google OAuth).
# ============================================================================

# ---- Core ----
# One of: development | production | testing
FLASK_CONFIG=development
# Generate a strong value in production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=dev-secret-change-me

# ---- Database ----
# In development, if DATABASE_URL is unset the app uses a local SQLite file.
# In production, set a PostgreSQL URL, e.g.:
# DATABASE_URL=postgresql+psycopg://petship:petship@db:5432/petship
DATABASE_URL=

# ---- Redis (SocketIO message queue + caching) ----
# If unset, SocketIO runs single-process without a message queue (fine for dev).
REDIS_URL=

# ---- SocketIO async mode ----
# "threading" (default) works everywhere with no monkey-patching.
# Set to "eventlet" in production and run under `gunicorn -k eventlet`.
SOCKETIO_ASYNC_MODE=threading

# ---- Server base URL (used for links in emails, OAuth callbacks) ----
SERVER_NAME=
PREFERRED_URL_SCHEME=http

# ---- Email (console mode does not deliver email) ----
# Provider: console | smtp | resend
# Set MAIL_PROVIDER=smtp and configure the SMTP values below, or set
# MAIL_PROVIDER=resend and provide a Resend API key, to send real email.
MAIL_PROVIDER=console
MAIL_DEFAULT_SENDER=PetShip <hello@petship.com>
# SMTP settings (used when MAIL_PROVIDER=smtp)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# Resend settings (used when MAIL_PROVIDER=resend)
RESEND_API_KEY=

# ---- Firebase Cloud Storage (fallback: local filesystem storage when unset) ----
# Provide EITHER a path to the service-account JSON file:
FIREBASE_CREDENTIALS_FILE=
# ...OR the service-account JSON inline (as a single-line string):
FIREBASE_CREDENTIALS=
# The storage bucket name, e.g. my-petship-app.appspot.com
FIREBASE_STORAGE_BUCKET=

# ---- Google Gemini (fallback: safe templated responses when unset) ----
# Free tier available via Google AI Studio. Add this ONLY when you want live
# AI chatbot responses; without it, PetShip uses safe templated answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Google OAuth (fallback: "Continue with Google" hidden when unset) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
